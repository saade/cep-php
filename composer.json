{
    "name": "saade/cep-php",
    "description": "Async, high availability brazilian CEP finder with multiple providers for redundancy.",
    "keywords": [
        "saade",
        "laravel",
        "cep-php",
        "cep",
        "correios",
        "viacep",
        "brasil api"
    ],
    "homepage": "https://github.com/saade/cep-php",
    "license": "MIT",
    "authors": [
        {
            "name": "Saade",
            "email": "saade@outlook.com.br",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.1",
        "guzzlehttp/guzzle": "^7.15.2|^8.0.1",
        "spatie/laravel-package-tools": "^1.14.0"
    },
    "autoload": {
        "files": [
            "src/helpers.php"
        ],
        "psr-4": {
            "Saade\\Cep\\": "src/"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "test:live": "vendor/bin/pest --testsuite=Live"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Saade\\Cep\\CepServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require-dev": {
        "orchestra/testbench": "^11.3",
        "pestphp/pest": "^5.3"
    }
}
